{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:mock": "VITE_USE_MOCK=true vite",
    "build:static": "VITE_STATIC=true VITE_USE_MOCK=false VITE_API_BASE_URL= tsc -b && VITE_STATIC=true VITE_USE_MOCK=false VITE_API_BASE_URL= vite build --outDir ../site --emptyOutDir && rm -f ../site/mockServiceWorker.js"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
