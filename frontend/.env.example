# One switch decides where data comes from.
#   true  -> the in-browser mock server (no backend needed)
#   false -> the real API at VITE_API_BASE_URL
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
# The buyer used for new orders (the sandbox has no sign-in). Exists in the generated data.
VITE_DEMO_BUYER_ID=B-000001
